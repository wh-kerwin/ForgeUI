            },
            { "name": "id", "type": "string", "constraints": { "readonly": true } }
          ],
          "rows": [],
          "operations": [
            { "operation_id": "listOrders", "method": "GET", "path": "/orders", "role": "list" },
            { "operation_id": "createOrder", "method": "POST", "path": "/orders", "role": "create" }
          ]
        },
        "authorizedOperations": ["GET /orders · listOrders", "POST /orders · createOrder"],
        "formValues": { "id": "1", "name": "hidden", "unknown": "leak" },
