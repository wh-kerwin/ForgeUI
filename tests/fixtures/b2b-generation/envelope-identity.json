{
  "cases": [
    {
      "id": "envelope-nested-id",
      "category": "envelope",
      "description": "Nested record IDs are resolved by an explicit rowKeyPointer.",
      "input": {
        "prompt": "嵌套 ID 的订单",
        "scene": "query",
        "definition": {
          "title": "Orders",
          "description": "",
          "filters": [],
          "stats": [],
          "columns": ["id"],
          "rows": [],
          "operations": [
            { "operation_id": "listOrders", "method": "GET", "path": "/orders", "role": "list" }
          ]
        },
        "authorizedOperations": ["GET /orders · listOrders"],
        "binding": {
          "operationKey": "GET /orders · listOrders",
          "itemsPointer": "/data/items",
          "rowKeyPointer": "/meta/id",
          "fieldPointers": ["/meta/id"],
          "confirmed": true
        },
        "body": { "data": { "items": [{ "meta": { "id": "a" } }, { "meta": { "id": "b" } }] } },
        "filters": {},
        "declaredQueryParameters": []
      },
      "expected": {
        "recordCount": 2,
        "identityCount": 2,
        "queryStatus": "success",
        "outcome": "success"
      }
    },
    {
