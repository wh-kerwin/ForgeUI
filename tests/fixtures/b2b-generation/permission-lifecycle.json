      "id": "permission-unauthorized-operation",
      "category": "permission",
      "description": "An operation outside the authorized set is refused before execution.",
      "input": {
        "prompt": "生成带删除的订单页",
        "scene": "crud",
        "definition": {
          "title": "Orders",
          "description": "",
          "filters": [],
          "stats": [],
          "columns": ["id"],
          "rows": [],
          "operations": [
            { "operation_id": "listOrders", "method": "GET", "path": "/orders", "role": "list" },
            {
              "operation_id": "deleteOrder",
              "method": "DELETE",
              "path": "/orders/{id}",
              "role": "delete"
            }
          ]
        },
        "authorizedOperations": ["GET /orders · listOrders"],
        "filters": {},
        "declaredQueryParameters": []
      },
      "expected": {
        "contractAccepted": true,
        "bindingAccepted": false,
        "writesDisabled": true,
        "outcome": "unbound"
      }
    },
