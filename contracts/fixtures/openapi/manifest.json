{
  "cases": [
    {
      "id": "3.1-envelope-string-and-number-ids",
      "spec": "orders-3.1.json",
      "specVersion": "3.1.0",
      "operation": "GET /orders · listOrders",
      "operationId": "listOrders",
      "itemsPointer": "/data/items",
      "itemsPointerOrigin": "schema",
      "totalPointer": "/data/total",
      "rowKeyPointer": "/id",
      "fieldPointers": ["/id", "/amount", "/status", "/a~1b", "/~0key"],
      "sampleResponse": {
        "data": {
          "items": [
            { "id": "001", "amount": 10.5, "status": "new", "a/b": "sample-a", "~key": true },
            { "id": 1, "amount": 20.0, "status": "done", "a/b": "sample-b", "~key": false },
            { "id": "001", "amount": 30.25, "status": "new", "a/b": "sample-c", "~key": true }
          ],
          "total": 3
        }
      },
      "expected": {
        "status": "mapped",
        "recordCount": 3,
        "total": 3,
        "keys": ["string:001", "number:1", "string:001"],
        "writable": false
      }
    },
